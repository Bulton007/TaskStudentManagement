<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_DIR" value="logs"/>
    <property name="ARCHIVE_DIR" value="${LOG_DIR}/archive"/>

    <!-- JSON request and response logs -->
    <appender name="API_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_DIR}/api-audit.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>
                ${ARCHIVE_DIR}/api-audit-%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>

        <!-- ApiLoggingFilter already produces JSON -->
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <!-- Only controlled API and third-party errors -->
    <appender name="ERROR_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_DIR}/error.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>
                ${ARCHIVE_DIR}/error-%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <charset>UTF-8</charset>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <!-- Terminal shows only warnings and errors -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>

        <encoder>
            <charset>UTF-8</charset>
            <pattern>
                %d{HH:mm:ss.SSS} %-5level %logger{30} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- Used by ApiLoggingFilter -->
    <logger name="API_AUDIT"
            level="INFO"
            additivity="false">
        <appender-ref ref="API_FILE"/>
    </logger>

    <!-- Used by exception handler and GlobalThirdPartyClient -->
    <logger name="API_ERROR"
            level="ERROR"
            additivity="false">
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Do not write normal Spring startup information to files -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>